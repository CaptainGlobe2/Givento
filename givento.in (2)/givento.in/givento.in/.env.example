# Supabase Configuration (Get these from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin Secret Password for /admin login (Defaults to 'givento2026' if unset)
ADMIN_PASSWORD=givento2026
ADMIN_SESSION_SECRET=your_super_secret_session_key

# Razorpay Keys (Optional - switched on later, not mandatory for WhatsApp checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkey
RAZORPAY_KEY_SECRET=your_secret_key

# WhatsApp Business / Studio Contact Number (Format: 919XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Server-Side AI LLM API (Provider choice: Gemini / OpenAI / Anthropic; stays strictly on server)
AI_API_KEY=your_server_ai_api_key
AI_PROVIDER=gemini
